# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model for both Wren and her sub-skills. Override per-agent if you want.
WREN_MODEL=claude-sonnet-4-6

# Thinking effort. low | medium | high | max
# Wren is conversational, so she runs lower; the writing sub-skill drafts prose
# and gets more room.
WREN_EFFORT=medium
WREN_WRITING_EFFORT=high

# --- Persona -----------------------------------------------------------
# Wren addresses you by name. This is that name.
WREN_USER_NAME=Jules

# --- Database ----------------------------------------------------------
# Local dev: SQLite. Leave as-is and run `npm run db:migrate`.
DATABASE_URL=sqlite:./data/wren.sqlite

# Production: Postgres, required. Anything starting postgres:// or postgresql://
# switches the driver automatically. SQLite is rejected on Vercel, where the
# filesystem is ephemeral and every write would be lost between requests.
# DATABASE_URL=postgresql://user:pass@host:5432/wren

# --- Scheduler ---------------------------------------------------------
# Protects /api/cron/checkin. Vercel Cron sends it as a bearer token.
# Unset in dev the route is open; unset in production it refuses to run.
CRON_SECRET=

# Used for streak day boundaries. Defaults to UTC, which will feel wrong if
# you write late at night.
WREN_TIMEZONE=Europe/London
